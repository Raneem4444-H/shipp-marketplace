# Copy these NAMES into Streamlit Community Cloud:
# App -> Settings -> Secrets
#
# DO NOT commit real values. This file contains placeholders only.

[databricks]
DATABRICKS_HOST = "https://<workspace-host>"
DATABRICKS_CLIENT_ID = "<service-principal-client-id>"
DATABRICKS_CLIENT_SECRET = "<service-principal-secret>"

[databricks]
DATABRICKS_HOST = "YOUR_REAL_VALUE"
DATABRICKS_CLIENT_ID = "YOUR_REAL_VALUE"
DATABRICKS_CLIENT_SECRET = "YOUR_REAL_SECRET"

[lakebase]
PGHOST = "<lakebase-host>"
PGPORT = "5432"
PGDATABASE = "databricks_postgres"
PGUSER = "<lakebase-postgres-role>"
PGSSLMODE = "require"
SHIPP_LAKEBASE_ENDPOINT = "projects/<project>/branches/<branch>/endpoints/<endpoint>"
SHIPP_LAKEBASE_SCHEMA = "shipp"

[lakebase]
PGHOST = "YOUR_REAL_VALUE"
PGPORT = "5432"
PGDATABASE = "databricks_postgres"
PGUSER = "YOUR_REAL_VALUE"
PGSSLMODE = "require"

SHIPP_LAKEBASE_ENDPOINT = "YOUR_REAL_VALUE"
SHIPP_LAKEBASE_SCHEMA = "shipp"

[shipp]
SHIPP_DEPLOYMENT_TARGET = "streamlit_cloud"
SHIPP_LLM_ENDPOINT = "<databricks-model-serving-endpoint>"
SHIPP_SQL_WAREHOUSE_ID = "<sql-warehouse-id>"
SHIPP_CANDIDATE_MATCHES_TABLE = "bootcamp_students.shipp_gold.gold_candidate_matches"
SHIPP_SEARCH_INDEX = "bootcamp_students.shipp_gold.gold_listing_search_docs_index"
SHIPP_LISTING_IMAGE_VOLUME = "/Volumes/bootcamp_students/shipp_bronze/listing_images"
SHIPP_SHOW_EVIDENCE = "true"

[shipp]
SHIPP_DEPLOYMENT_TARGET = "streamlit_cloud"

SHIPP_LLM_ENDPOINT = "YOUR_REAL_VALUE"

SHIPP_SQL_WAREHOUSE_ID = "YOUR_REAL_VALUE"

SHIPP_CANDIDATE_MATCHES_TABLE = "bootcamp_students.shipp_gold.gold_candidate_matches"

SHIPP_SEARCH_INDEX = "YOUR_REAL_VALUE"

SHIPP_LISTING_IMAGE_VOLUME = "/Volumes/bootcamp_students/shipp_bronze/listing_images"

SHIPP_SHOW_EVIDENCE = "true"
