+
+    # ------------------------------------------------------------------
+    # DELIVERY COMPANY (read-only)
+    # ------------------------------------------------------------------
+
+    def list_delivery_jobs(self, limit: int = 50) -> list[dict[str, Any]]:
+        """Saved items with their pickup (listing) and drop-off (request) areas.
+
+        Read-only. A saved item is the only operational record that links a
+        listing to a request, so it is the source for delivery work.
+        """
+
+        with self._connect() as conn, conn.cursor() as cur:
+            cur.execute(
+                f"""
+                SELECT
+                    s.saved_item_id,
+                    l.title,
+                    l.condition,
+                    l.location AS pickup_location,
+                    r.location AS dropoff_location,
+                    s.saved_at
+                FROM {self._schema}.saved_items s
+                JOIN {self._schema}.listings l
+                  ON l.listing_id = s.listing_id
+                JOIN {self._schema}.requests r
+                  ON r.request_id = s.request_id
+                ORDER BY s.saved_at DESC
+                LIMIT %s
+                """,
+                (int(limit),),
+            )
+            rows = cur.fetchall()
+
+        return [
+            {
+                "saved_item_id": row[0],
+                "title": row[1],
+                "condition": row[2],
+                "pickup_location": row[3],
+                "dropoff_location": row[4],
+                "saved_at": row[5],
+            }
+            for row in rows
+        ]
diff --git a/test/unit/test_app_login.py b/test/unit/test_app_login.py
new file mode 100644
index 0000000..67ead0e
--- /dev/null
+++ b/test/unit/test_app_login.py
@@ -0,0 +1,245 @@
+"""Tests for the log in / sign up screens (app_login.py).
+
+Streamlit is replaced by a small fake so the screen logic runs without a
+browser or a Lakebase connection.
+"""
+
+import contextlib
+import importlib
+import sys
+import types
+
+import app_auth
+
+
+class _Stop(Exception):
+    pass
+
+
+class _Rerun(Exception):
+    pass
+
+
+class _Ctx:
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+
+class FakeStreamlit(types.ModuleType):
+    def __init__(self, *, values=None, clicked=()):
+        super().__init__("streamlit")
+        self.session_state = {}
+        self.values = values or {}
+        self.clicked = set(clicked)
+        self.errors = []
+        self.messages = []
+
+    # layout
+    def tabs(self, labels):
+        return [_Ctx() for _ in labels]
+
+    def columns(self, spec):
+        return [_Ctx() for _ in (spec if isinstance(spec, list) else range(spec))]
+
+    def form(self, key):
+        return _Ctx()
+
+    # inputs
+    def selectbox(self, label, options, **kwargs):
+        return self.values.get(label, options[0])
+
+    def radio(self, label, options, **kwargs):
+        return self.values.get(label, options[0])
+
+    def text_input(self, label, **kwargs):
+        return self.values.get(label, "")
+
+    def form_submit_button(self, label, **kwargs):
+        return label in self.clicked
+
+    def button(self, label, **kwargs):
+        return label in self.clicked
+
+    # output
+    def markdown(self, text, **kwargs):
+        self.messages.append(text)
+
+    def error(self, text):
+        self.errors.append(text)
+
+    info = success = code = markdown
+
+    # control flow
+    def stop(self):
+        raise _Stop()
+
+    def rerun(self):
+        raise _Rerun()
+
+
+class FakeAuth:
+    def __init__(self, profiles=()):
+        self.profiles = {p["user_id"]: dict(p) for p in profiles}
+        self.registered = []
+
+    def list_profiles(self, role_id=None):
+        return list(self.profiles.values())
+
+    def sign_in(self, user_id):
+        if user_id not in self.profiles:
+            raise app_auth.ProfileNotFound("Active SHIPP profile was not found.")
+        return self.profiles[user_id]
+
+    def register_profile(self, *, name, current_city, roles):
+        profile = {
+            "user_id": f"new-{len(self.registered) + 1}",
+            "name": name.strip(),
+            "current_city": current_city.strip(),
+            "roles": list(roles),
+        }
+        self.registered.append(profile)
+        self.profiles[profile["user_id"]] = profile
+        return profile
+
+
+@contextlib.contextmanager
+def login_module(fake_st):
+    """Import app_login against the fake Streamlit, then restore the real one."""
+
+    saved = {name: sys.modules.get(name) for name in ("streamlit", "app_login")}
+    sys.modules["streamlit"] = fake_st
+    sys.modules.pop("app_login", None)
+    try:
+        yield importlib.import_module("app_login")
+    finally:
+        for name, module in saved.items():
+            if module is None:
+                sys.modules.pop(name, None)
+            else:
+                sys.modules[name] = module
+
+
+DONOR = {"user_id": "demo-donor-001", "name": "Demo Donor", "current_city": "Abu Dhabi", "roles": ["DONOR"]}
+REQUESTER = {"user_id": "demo-requester-001", "name": "Demo Requester", "current_city": "Abu Dhabi", "roles": ["REQUESTER"]}
+
+
+def _run(fn, *args):
+    try:
+        fn(*args)
+    except _Stop:
+        return "stop"
+    except _Rerun:
+        return "rerun"
+    return "returned"
+
+
+def test_gate_blocks_the_app_when_nobody_is_signed_in():
+    st = FakeStreamlit()
+    with login_module(st) as login:
+        assert _run(login.render_auth_gate, FakeAuth([DONOR])) == "stop"
+        assert login.SESSION_KEY not in st.session_state
+
+
+def test_log_in_stores_the_selected_profile_and_reruns():
+    st = FakeStreamlit(
+        values={"Your profile": "Kim Stevens · Requester"},
+        clicked={"Log in"},
+    )
+    aliases = {"demo-requester-001": "Kim Stevens"}
+    with login_module(st) as login:
+        assert _run(login.render_auth_gate, FakeAuth([DONOR, REQUESTER]), aliases) == "rerun"
+        profile = st.session_state[login.SESSION_KEY]
+        assert profile["user_id"] == "demo-requester-001"
+        assert profile["roles"] == ["REQUESTER"]
+        # Second run: the gate lets the signed-in profile through.
+        st.clicked = set()
+        assert login.render_auth_gate(FakeAuth([DONOR, REQUESTER]), aliases) == profile
+
+
+def test_sign_up_creates_one_profile_with_the_chosen_role():
+    for role in ("DONOR", "REQUESTER", "SHIPPING_PARTNER"):
+        st = FakeStreamlit(
+            values={
+                "I want to sign up as": role,
+                "Full name or company name": "  Roro  ",
+                "City": "Amman",
+            },
+            clicked={"Create account"},
+        )
+        auth = FakeAuth()
+        with login_module(st) as login:
+            assert _run(login.render_auth_gate, auth) == "rerun"
+            assert len(auth.registered) == 1
+            assert auth.registered[0]["roles"] == [role]
+            assert st.session_state[login.SESSION_KEY]["user_id"] == "new-1"
+            assert login.journeys_for(st.session_state[login.SESSION_KEY]) == [
+                login.ROLE_JOURNEYS[role]
+            ]
+
+
+def test_sign_up_without_a_name_or_city_writes_nothing():
+    for values in (
+        {"Full name or company name": "", "City": "Amman"},
+        {"Full name or company name": "Roro", "City": "  "},
+    ):
+        st = FakeStreamlit(values=values, clicked={"Create account"})
+        auth = FakeAuth()
+        with login_module(st) as login:
+            assert _run(login.render_auth_gate, auth) == "stop"
+            assert auth.registered == []
+            assert st.errors
+            assert login.SESSION_KEY not in st.session_state
+
+
+def test_log_out_clears_the_profile_and_per_user_state():
+    st = FakeStreamlit(clicked={"Log out"})
+    with login_module(st) as login:
+        login.start_session(DONOR)
+        st.session_state["messages"] = ["private chat"]
+        st.session_state["active_request_id"] = "demo-request-001"
+        assert _run(login.render_account_bar, DONOR) == "rerun"
+        assert login.SESSION_KEY not in st.session_state
+        assert "messages" not in st.session_state
+        assert "active_request_id" not in st.session_state
+
+
+def test_switching_profile_does_not_keep_the_previous_users_state():
+    st = FakeStreamlit()
+    with login_module(st) as login:
+        login.start_session(REQUESTER)
+        st.session_state["pending_save"] = {"listing_id": "x"}
+        login.start_session(DONOR)
+        assert "pending_save" not in st.session_state
+        assert st.session_state[login.SESSION_KEY]["user_id"] == DONOR["user_id"]
