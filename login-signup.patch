diff --git a/app_login.py b/app_login.py
new file mode 100644
index 0000000..dd2a38f
--- /dev/null
+++ b/app_login.py
@@ -0,0 +1,250 @@
+"""Log in / sign up screens for the SHIPP Streamlit app.
+
+The screens sit in front of the marketplace and call ``ShippAuthRepo``
+(``app_auth.py``), which reads and writes ``shipp.users`` and
+``shipp.user_roles`` in Lakebase.
+
+There is no password. The SHIPP schema has no credential columns and identity
+verification is outside P0, so "log in" means choosing an existing active
+profile. Do not present this as secure authentication.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from typing import Any
+
+import streamlit as st
+
+from app_auth import AuthError, ShippAuthRepo
+
+
+SESSION_KEY = "shipp_profile"
+WELCOME_KEY = "shipp_welcome"
+
+JOURNEY_GIVE = "Give an item"
+JOURNEY_FIND = "Find an item"
+JOURNEY_DELIVER = "Deliver items"
+
+# Order here is the order shown on screen.
+ROLE_LABELS = {
+    "DONOR": "Donor",
+    "REQUESTER": "Requester",
+    "SHIPPING_PARTNER": "Delivery company",
+}
+
+ROLE_HINTS = {
+    "DONOR": "I have household items to give away",
+    "REQUESTER": "I need household items",
+    "SHIPPING_PARTNER": "We pick up and deliver items",
+}
+
+ROLE_JOURNEYS = {
+    "DONOR": JOURNEY_GIVE,
+    "REQUESTER": JOURNEY_FIND,
+    "SHIPPING_PARTNER": JOURNEY_DELIVER,
+}
+
+# Per-user state that must not leak from one signed-in profile to the next.
+# app.py restores its defaults for these on the next run.
+_USER_STATE_KEYS = (
+    "messages",
+    "pending_save",
+    "tool_trace",
+    "active_request_id",
+    "active_requester_id",
+    "last_created_listing_id",
+    "last_created_request_id",
+    "last_saved_item_id",
+    "last_saved_listing_id",
+    "last_save_status",
+    "last_saved_refresh_pass",
+    "last_agent_read_tools",
+)
+
+
+def display_name(profile: Mapping[str, Any], aliases: Mapping[str, str] | None) -> str:
+    return (aliases or {}).get(profile["user_id"], profile["name"])
+
+
+def roles_text(roles: list[str]) -> str:
+    return ", ".join(ROLE_LABELS[r] for r in ROLE_LABELS if r in roles)
+
+
+def profile_options(
+    profiles: list[dict[str, Any]],
+    aliases: Mapping[str, str] | None = None,
+) -> dict[str, str]:
+    """Map a readable, unique label to each profile's user_id."""
+
+    options: dict[str, str] = {}
+    for profile in profiles:
+        roles = roles_text(profile.get("roles") or [])
+        if not roles:
+            # Profile only has roles this app has no screen for.
+            continue
+        label = f"{display_name(profile, aliases)} · {roles}"
+        if label in options:
+            label = f"{label} · {profile['user_id'][:8]}"
+        options[label] = profile["user_id"]
+    return options
+
+
+def journeys_for(profile: Mapping[str, Any]) -> list[str]:
+    roles = profile.get("roles") or []
+    return [ROLE_JOURNEYS[r] for r in ROLE_JOURNEYS if r in roles]
+
+
+def start_session(profile: Mapping[str, Any]) -> None:
+    clear_user_state()
+    st.session_state[SESSION_KEY] = {
+        "user_id": profile["user_id"],
+        "name": profile["name"],
+        "current_city": profile.get("current_city"),
+        "roles": list(profile.get("roles") or []),
+    }
+
+
+def clear_user_state() -> None:
+    for key in _USER_STATE_KEYS:
+        st.session_state.pop(key, None)
+
+
+def sign_out() -> None:
+    clear_user_state()
+    st.session_state.pop(SESSION_KEY, None)
+    st.session_state.pop(WELCOME_KEY, None)
+
+
+def _render_login(auth: ShippAuthRepo, aliases: Mapping[str, str] | None) -> None:
+    try:
+        options = profile_options(auth.list_profiles(), aliases)
+    except Exception as exc:
+        st.error("Profiles are temporarily unavailable.")
+        st.code(str(exc))
+        return
+
+    if not options:
+        st.info("No profiles exist yet. Use the Sign up tab to create the first one.")
+        return
+
+    with st.form("shipp_login_form"):
+        label = st.selectbox("Your profile", list(options))
+        submitted = st.form_submit_button("Log in", use_container_width=True)
+
+    if not submitted:
+        return
+
+    try:
+        profile = auth.sign_in(options[label])
+    except AuthError as exc:
+        st.error(str(exc))
+        return
+    except Exception as exc:
+        st.error("Log in failed. Nothing was changed.")
+        st.code(str(exc))
+        return
+
+    start_session(profile)
+    st.rerun()
+
+
+def _render_signup(auth: ShippAuthRepo) -> None:
+    with st.form("shipp_signup_form"):
+        role = st.radio(
+            "I want to sign up as",
+            list(ROLE_LABELS),
+            format_func=lambda r: f"{ROLE_LABELS[r]} — {ROLE_HINTS[r]}",
+        )
+        name = st.text_input("Full name or company name")
+        city = st.text_input("City", placeholder="e.g. Abu Dhabi")
+        submitted = st.form_submit_button("Create account", use_container_width=True)
+
+    if not submitted:
+        return
+
+    if not name.strip():
+        st.error("Please enter a name.")
+        return
+    if not city.strip():
+        st.error("Please enter a city.")
+        return
+
+    try:
+        profile = auth.register_profile(
+            name=name,
+            current_city=city,
+            roles=[role],
+        )
+    except AuthError as exc:
+        st.error(str(exc))
+        return
+    except Exception as exc:
+        st.error("The account could not be created. Nothing was saved.")
+        st.code(str(exc))
+        return
+
+    start_session(profile)
+    st.session_state[WELCOME_KEY] = True
+    st.rerun()
+
+
+def render_auth_gate(
+    auth: ShippAuthRepo,
+    aliases: Mapping[str, str] | None = None,
+) -> dict[str, Any]:
+    """Return the signed-in profile, or show log in / sign up and stop."""
+
+    profile = st.session_state.get(SESSION_KEY)
+    if profile:
+        return profile
+
+    st.markdown("## Log in or create an account")
+    login_tab, signup_tab = st.tabs(["Log in", "Sign up"])
+    with login_tab:
+        _render_login(auth, aliases)
+    with signup_tab:
+        _render_signup(auth)
+
+    st.stop()
+    raise RuntimeError("unreachable: st.stop() ends the script run")
+
+
+def render_account_bar(
+    profile: Mapping[str, Any],
+    aliases: Mapping[str, str] | None = None,
+) -> None:
+    left, right = st.columns([5, 1])
+    with left:
+        st.markdown(
+            f"Signed in as **{display_name(profile, aliases)}** · "
+            f"{roles_text(profile.get('roles') or [])}"
+        )
+    with right:
+        if st.button("Log out", key="shipp_logout", use_container_width=True):
+            sign_out()
+            st.rerun()
+
+    if st.session_state.pop(WELCOME_KEY, False):
+        st.success("Your account is created. Next time, pick your name on the Log in tab.")
+
+
+def choose_journey(profile: Mapping[str, Any]) -> str:
+    """Pick the journey from the profile's roles; ask only if there are several."""
+
+    journeys = journeys_for(profile)
+    if not journeys:
+        st.error("This profile has no role this app supports.")
+        st.stop()
+        raise RuntimeError("unreachable: st.stop() ends the script run")
+
+    if len(journeys) == 1:
+        return journeys[0]
+
+    st.markdown("## What would you like to do?")
+    return st.radio(
+        "Choose your marketplace journey",
+        journeys,
+        horizontal=True,
+        label_visibility="collapsed",
+    )
